# Default: Ollama for generation, judge, and RAGAS (fully local)
XAI_LLM_BACKEND=ollama
XAI_JUDGE_BACKEND=ollama
XAI_RAGAS_BACKEND=ollama

# Ollama (default generation) — chat models only
XAI_OLLAMA_URL=http://localhost:11434
XAI_OLLAMA_MODEL=llama3
XAI_OLLAMA_JUDGE_MODEL=llama3
# Comma-separated priority if XAI_OLLAMA_MODEL unset:
# XAI_OLLAMA_PREFERRED=llama3.1,llama3,gemma2,mistral,phi4,qwen2.5

# OpenAI (optional — set XAI_*_BACKEND=openai to use)
OPENAI_API_KEY=sk-proj-...
XAI_OPENAI_MODEL=gpt-4o-mini
XAI_OPENAI_JUDGE_MODEL=gpt-4o-mini

# RAGAS evaluator (Batal et al. 2026 aligned — 6 metrics)
# Ollama defaults: same chat model as generation; nomic-embed-text for embeddings
# ollama pull nomic-embed-text
XAI_RAGAS_MODEL=
XAI_RAGAS_EMBEDDING_MODEL=nomic-embed-text
# OpenAI RAGAS (when XAI_RAGAS_BACKEND=openai):
# XAI_RAGAS_MODEL=gpt-4o
# XAI_RAGAS_EMBEDDING_MODEL=text-embedding-3-small
